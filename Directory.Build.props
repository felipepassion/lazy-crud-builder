<Project>
  <!--
    Single version source for the whole platform. Every package, the platform descriptor and the
    generated-code markers derive from LazyCrudVersion; no project file declares its own version.
    Override for local experiments with: dotnet pack -p:LazyCrudVersion=1.2.3
  -->
  <PropertyGroup>
    <LazyCrudVersion Condition="'$(LazyCrudVersion)' == ''">1.1.1</LazyCrudVersion>
    <Version>$(LazyCrudVersion)</Version>
    <LazyCrudRepoRoot>$(MSBuildThisFileDirectory)</LazyCrudRepoRoot>
    <LazyCrudDescriptorPath>$(MSBuildThisFileDirectory)artifacts\platform\lazycrud.platform.json</LazyCrudDescriptorPath>
    <!-- Local template development mode: templates under src/ProjectFiles resolve shared includes here. -->
    <LazyCrudTemplatesRoot Condition="'$(LazyCrudTemplatesRoot)' == ''">$(MSBuildThisFileDirectory)src\ProjectFiles\</LazyCrudTemplatesRoot>
    <!-- The shared writer assembly referenced by project.tt (netstandard2.0, built by this solution). -->
    <LazyCrudPlatformAssembly Condition="'$(LazyCrudPlatformAssembly)' == ''">$(MSBuildThisFileDirectory)src\Platform\Lazy.Crud.Builder.Platform\bin\$(Configuration)\netstandard2.0\Lazy.Crud.Builder.Platform.dll</LazyCrudPlatformAssembly>
  </PropertyGroup>

  <!-- Common package metadata applied to all packable projects -->
  <PropertyGroup>
    <RepositoryUrl>https://github.com/felipepassion/lazy-crud-builder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/felipepassion/lazy-crud-builder</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <Title>$(MSBuildProjectName)</Title>
    <Description>Lazy CRUD Builder - $(MSBuildProjectName)</Description>
    <Authors>felipepassion</Authors>
    <Company>lazy-crud-builder</Company>
    <PackageTags>lazycrud;crud;builder;dotnet</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == ''">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Ensure root README.md is included in the nupkg for packable projects -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- SourceLink for better debugging experience -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
