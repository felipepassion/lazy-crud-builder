<Project>

  <!-- Ensure IsPackable is set for class libraries (after project evaluation) -->
  <PropertyGroup>
    <IsPackable Condition="'$(IsPackable)' == '' and '$(IsTestProject)' != 'true' and '$(OutputType)' == 'Library'">true</IsPackable>
  </PropertyGroup>

  <!--
    Distribution strategy (decision D8): layer-specific templates ship in their layer's runtime
    package; every layer package depends on the canonical templates package, which carries the
    shared templates, the writer assembly and the MSBuild props. PrivateAssets=none makes the
    dependency flow content files and build assets to consumers.
  -->
  <PropertyGroup>
    <_LazyCrudLayerPackages>;Lazy.Crud.Builder.Domain;Lazy.Crud.Builder.Application;Lazy.Crud.Builder.Application.DTO;Lazy.Crud.Builder.Infra.Data;Lazy.Crud.Builder.Infra.IoC;Lazy.Crud.Builder.Api;Lazy.Crud.Builder.Api.Queries;Lazy.Crud.Builder.Enumeration;Lazy.Crud.Builder.WebApi;</_LazyCrudLayerPackages>
    <LazyCrudIsLayerPackage Condition="'$(LazyCrudIsLayerPackage)' == '' and $(_LazyCrudLayerPackages.Contains(';$(MSBuildProjectName);'))">true</LazyCrudIsLayerPackage>
  </PropertyGroup>
  <ItemGroup Condition="'$(LazyCrudIsLayerPackage)' == 'true'">
    <ProjectReference Include="$(LazyCrudRepoRoot)src\Templates\LazyCrud.Templates\Lazy.Crud.Builder.Templates.csproj" PrivateAssets="none" />
  </ItemGroup>

  <!--
    Version drift check: a project that declares its own Version (or PackageVersion) disagreeing
    with the central LazyCrudVersion fails the build, naming the project and both values.
  -->
  <Target Name="LazyCrudValidateVersion" BeforeTargets="CoreCompile;GenerateNuspec" Condition="'$(IsPackable)' == 'true'">
    <Error Condition="'$(Version)' != '$(LazyCrudVersion)'"
           Text="Version drift: project '$(MSBuildProjectName)' declares Version '$(Version)' but the central LazyCrudVersion is '$(LazyCrudVersion)'. Remove the project-level Version element; the platform has a single version source (Directory.Build.props)." />
    <Error Condition="'$(PackageVersion)' != '' and '$(PackageVersion)' != '$(LazyCrudVersion)'"
           Text="Version drift: project '$(MSBuildProjectName)' declares PackageVersion '$(PackageVersion)' but the central LazyCrudVersion is '$(LazyCrudVersion)'." />
  </Target>

  <!--
    Embed the platform descriptor in every package at the fixed, documented path
    lazycrud/lazycrud.platform.json. The descriptor is generated by the Platform tool after the
    solution builds (see the LazyCrudGenerateDescriptor target below); packing without it fails.
  -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);LazyCrudEmbedDescriptor</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="LazyCrudEmbedDescriptor" Condition="'$(IsPackable)' == 'true'">
    <Error Condition="!Exists('$(LazyCrudDescriptorPath)')"
           Text="The platform descriptor '$(LazyCrudDescriptorPath)' does not exist. Build the solution (the Lazy.Crud.Builder.Platform.Tool project generates it) before packing '$(MSBuildProjectName)'." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(LazyCrudDescriptorPath)" PackagePath="lazycrud/" />
    </ItemGroup>
  </Target>

  <!--
    Generate the descriptor from the build. Runs after the Platform tool builds (it references the
    Application.DTO project for ordering only, so the attribute catalog reflects the freshly built
    assembly and its XML documentation).
  -->
  <Target Name="LazyCrudGenerateDescriptor" AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'Lazy.Crud.Builder.Platform.Tool' and '$(LazyCrudSkipDescriptorGeneration)' != 'true'">
    <PropertyGroup>
      <_LazyCrudToolDll>$(TargetDir)$(TargetFileName)</_LazyCrudToolDll>
      <_LazyCrudDtoAssembly>$(LazyCrudRepoRoot)src\Builder\Builder.Application.DTO\bin\$(Configuration)\net10.0\Lazy.Crud.Builder.Application.DTO.dll</_LazyCrudDtoAssembly>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(_LazyCrudToolDll)&quot; descriptor generate --repo &quot;$(LazyCrudRepoRoot).&quot; --version $(LazyCrudVersion) --attributes-assembly &quot;$(_LazyCrudDtoAssembly)&quot; --output &quot;$(LazyCrudDescriptorPath)&quot; --fixtures &quot;$(LazyCrudRepoRoot)contracts&quot;"
          StandardOutputImportance="low" />
  </Target>

</Project>
