    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageVersion Include="Lazy.Crud.Builder.Api" Version="1.0.35" GeneratePathProperty="true" />
    <PackageVersion Include="Lazy.Crud.Builder.Api.Queries" Version="1.0.35" GeneratePathProperty="true" />
    <PackageVersion Include="Lazy.Crud.Builder.Application" Version="1.0.35" GeneratePathProperty="true" />
    <PackageVersion Include="Lazy.Crud.Builder.Application.DTO" Version="1.0.35" GeneratePathProperty="true" />
    <PackageVersion Include="Lazy.Crud.Builder.Application.DTO.Http.Models" Version="1.0.35" GeneratePathProperty="true" />
    <PackageVersion Include="Lazy.Crud.Builder.Application.Validators" Version="1.0.35" GeneratePathProperty="true" />
    <PackageVersion Include="Lazy.Crud.Builder.Domain" Version="1.0.35" GeneratePathProperty="true" />
    <PackageVersion Include="Lazy.Crud.Builder.Enumeration" Version="1.0.35" GeneratePathProperty="true" />
    <PackageVersion Include="Lazy.Crud.Builder.Infra.IoC" Version="1.0.35" GeneratePathProperty="true" />
    <PackageVersion Include="Lazy.Crud.Builder.Infra.Data" Version="1.0.35" GeneratePathProperty="true" />
    <PackageVersion Include="Lazy.Crud.CrossCutting.Infra.Utils" Version="1.0.35" GeneratePathProperty="true" />
    <PackageVersion Include="Lazy.Crud.CrossCutting.Application.Mail" Version="1.0.35" GeneratePathProperty="true" />
    <PackageVersion Include="Lazy.Crud.CrossCutting.Infra.Log" Version="1.0.35" GeneratePathProperty="true" />
    <PackageVersion Include="Lazy.Crud.CrossCutting.Domain" Version="1.0.35" GeneratePathProperty="true" />
    <PackageVersion Include="MediatR" Version="14.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.DataAnnotations.Validation" Version="3.2.0-rc1.20223.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Forms" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Abstractions" Version="2.3.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
