<# foreach(var namespaces in groupAllEntities) { #>
namespace <#= namespaces.Key.Replace("Entities", "Mappings").Replace("Domain","Infra.Data") #>
{
<#  var isFromSameAgg = AggName == namespaces.Key.Split('.').FirstOrDefault(x=>x.EndsWith("Agg"));
	foreach (var entity in namespaces) { 
        var oneToOneRelations = GetProperties(entity, includeIgnored: true).Where(x=>ContainsAttribute(x.Value, "OneToOne")).ToArray();
#>
public partial class <#= entity.Name #>Mapping : IEntityTypeConfiguration<<#= entity.FullName #>>
{
    public void Configure(EntityTypeBuilder<<#= entity.FullName #>> builder)
    {
<# if(!isFromSameAgg){ #>
        builder.Metadata.SetIsTableExcludedFromMigrations(true);
<#}#>
<# foreach(var item in oneToOneRelations){ #>
        builder.HasOne(x => x.<#= item.Key #>).WithOne().HasForeignKey<<#= item.Value.Type.AsFullName #>>("Id");
<#}#>
        builder.HasKey(x => x.Id);
        ConfigureAdditionalMapping(builder);
    }
	partial void ConfigureAdditionalMapping(EntityTypeBuilder<<#= entity.FullName #>> builder);
}
<# } #>
}
<# } #>
