<#@ include file="$(LazyCrudTemplatesRoot)project.tt" #>
<#@ include file="$(LazyCrudTemplatesRoot)Tests\Tests.Common.ttinclude" #>
<#
    InitTestVariables();
    if (_testEntities.Any()) {
    foreach(var namespaces in _testGroupEntities) {
        var aggName = namespaces.Key.Split('.').FirstOrDefault(x=>x.EndsWith("Agg"));
        foreach(var entity in namespaces) {
            var attrsDict = GetAttributesDict(entity);
            if (!attrsDict.ContainsKey("EndpointsT4") || !attrsDict["EndpointsT4"].Any()) continue;
            var attrs = attrsDict["EndpointsT4"];

            var controllerName = entity.Name + "Controller";
            var testClassName = entity.Name + "ControllerTests";
            // Controllers are generated into <SutProject>.Controllers (see Api/MiniControllers.tt).
            var controllerNs = GetSutProjectName("Api") + ".Controllers";
            WriteAutoGeneratedHeader("Api", entity.Name);
#>

using Xunit;

namespace <#= GetTestNamespace("Api") #>;

public class <#= testClassName #>
{
    [Fact]
    public void <#= controllerName #>_Type_Should_Exist()
    {
        var type = typeof(<#= controllerNs #>.<#= controllerName #>);
        Assert.NotNull(type);
        Assert.True(type.IsClass, "<#= controllerName #> should be a class.");
    }

    [Fact]
    public void <#= controllerName #>_Should_Have_Public_Methods()
    {
        var type = typeof(<#= controllerNs #>.<#= controllerName #>);
        var methods = type.GetMethods(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.DeclaredOnly);
        Assert.True(methods.Length > 0,
            $"<#= controllerName #> should have at least one public action method.");
    }
}
<#      SaveOutputToSubFolder(
            folderName: GetTestOutputPath(),
            outputFileName: $"{aggName}.{testClassName}.g.cs",
            recreateFileIfExists: true,
            ownership: Ownership.GeneratorOwned,
            templateId: "tests.api");
        } // foreach entity
    } // foreach namespace
} // if #>
