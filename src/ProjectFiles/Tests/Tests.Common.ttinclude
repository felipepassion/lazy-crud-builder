<#+
// ============================================================================
// Tests.Common.ttinclude — Shared helpers for T4-generated test files.
// Provides auto-generated headers, namespace helpers, and test scaffolding
// utilities used by all layer-specific test templates.
// ============================================================================

/// <summary>
/// Historical header hook. The generated-code marker written by the shared writer already
/// records the generator, aggregate, layer, template id, ownership and edit policy, so the
/// test templates no longer emit a header of their own. The method is kept as a no-op so that
/// custom templates written against earlier versions keep compiling.
/// </summary>
private void WriteAutoGeneratedHeader(string layerName, string entityName)
{
}

// ------------------------------------------------------------------
// Namespace helpers
// ------------------------------------------------------------------

/// <summary>
/// Builds the test namespace for a given layer relative to the aggregate.
/// Uses the current test project name as the base namespace.
/// E.g. "Lazy.Crud.Products.Tests.Domain.Generated"
/// </summary>
private string GetTestNamespace(string layerSuffix)
{
    var proj = GetCurrentProject();
    return proj.Name.Replace('-', '_').Replace(' ', '_') + ".Generated" +
           (string.IsNullOrWhiteSpace(layerSuffix) ? "" : "." + layerSuffix);
}

/// <summary>
/// Returns the SUT (System Under Test) namespace by replacing segments in
/// the entity namespace. For example Domain → Application.DTO, Entities → Requests.
/// </summary>
private string GetSutNamespace(string entityNamespace, string fromLayer, string toLayer, string fromSub, string toSub)
{
    var ns = entityNamespace;
    if (!string.IsNullOrWhiteSpace(fromLayer) && !string.IsNullOrWhiteSpace(toLayer))
        ns = ns.Replace(fromLayer, toLayer);
    if (!string.IsNullOrWhiteSpace(fromSub) && !string.IsNullOrWhiteSpace(toSub))
        ns = ns.Replace(fromSub, toSub);
    return ns;
}

/// <summary>
/// Name of the project under test for a test project of this aggregate: the current test project
/// name with the ".Tests" segment removed and the target layer appended, e.g.
/// "Lazy.Crud.Products.Tests.Api" + "Api" -> "Lazy.Crud.Products.Api". This is also the assembly
/// name and the root namespace of that layer project.
/// </summary>
private string GetSutProjectName(string targetLayer)
{
    var name = GetCurrentProject().Name;
    var marker = ".Tests.";
    var index = name.IndexOf(marker, StringComparison.Ordinal);
    var prefix = index >= 0 ? name.Substring(0, index) : name;
    return string.IsNullOrWhiteSpace(targetLayer) ? prefix : prefix + "." + targetLayer;
}

/// <summary>
/// Enums declared in the aggregate's Enumerations project, the canonical home for enums used by
/// entities. Only the project's own files are inspected: Project.CodeModel also exposes every type
/// of every referenced assembly, which would pull in the whole framework.
/// </summary>
private List<EnvDTE.CodeEnum> GetAggregateEnums()
{
    var result = new List<EnvDTE.CodeEnum>();
    var project = FindProject("Enumerations");
    if (project == null) return result;
    CollectEnumsFromItems(project.ProjectItems, result);
    return result;
}

private void CollectEnumsFromItems(EnvDTE.ProjectItems items, List<EnvDTE.CodeEnum> result)
{
    if (items == null) return;
    foreach (EnvDTE.ProjectItem item in items)
    {
        try
        {
            if (item.FileCodeModel != null) CollectEnums(item.FileCodeModel.CodeElements, result);
        }
        catch (Exception ex)
        {
            this.Warning("LC3005: the code model of '" + item.Name + "' could not be read and was skipped: " + ex.Message);
        }
        try
        {
            CollectEnumsFromItems(item.ProjectItems, result);
        }
        catch (Exception ex)
        {
            this.Warning("LC3005: the folder '" + item.Name + "' could not be walked and was skipped: " + ex.Message);
        }
    }
}

private void CollectEnums(EnvDTE.CodeElements elements, List<EnvDTE.CodeEnum> result)
{
    if (elements == null) return;
    foreach (EnvDTE.CodeElement element in elements)
    {
        EnvDTE.vsCMElement kind;
        try { kind = element.Kind; }
        catch (Exception ex) { this.Warning("LC3005: an element of the Enumerations code model could not be read and was skipped: " + ex.Message); continue; }
        try
        {
            if (kind == EnvDTE.vsCMElement.vsCMElementEnum) { result.Add((EnvDTE.CodeEnum)element); }
            else if (kind == EnvDTE.vsCMElement.vsCMElementNamespace) { CollectEnums(((EnvDTE.CodeNamespace)element).Members, result); }
            else if (kind == EnvDTE.vsCMElement.vsCMElementClass) { CollectEnums(((EnvDTE.CodeClass)element).Members, result); }
        }
        catch (Exception ex)
        {
            this.Warning("LC3005: enums could not be collected from a " + kind + " element: " + ex.Message);
        }
    }
}

/// <summary>Sanitises a name to be a valid C# identifier.</summary>
private string SanitizeIdentifier(string name)
{
    if (string.IsNullOrWhiteSpace(name)) return "_";
    var sb = new System.Text.StringBuilder();
    foreach (var c in name)
    {
        if (char.IsLetterOrDigit(c) || c == '_') sb.Append(c);
    }
    var result = sb.ToString();
    if (result.Length == 0 || char.IsDigit(result[0])) result = "_" + result;
    return result;
}

// ------------------------------------------------------------------
// Test class name helpers
// ------------------------------------------------------------------

private string NormalizeTestClassName(string entityName, string suffix = "Tests")
{
    return SanitizeIdentifier(entityName) + "Entity" + suffix;
}

private string NormalizeDtoTestClassName(string entityName)
{
    return SanitizeIdentifier(entityName) + "DtoSerializationTests";
}

// ------------------------------------------------------------------
// Output path helpers
// ------------------------------------------------------------------

/// <summary>Gets the test output subfolder path for generated tests.</summary>
private string GetTestOutputPath()
{
    var basePath = GetGenerationOutputPath();
    if (string.IsNullOrWhiteSpace(basePath))
        return "Generated";
    return basePath;
}

// ------------------------------------------------------------------
// Initialise common variables used by all test templates
// ------------------------------------------------------------------

private string _testAggName;
private List<EnvDTE.CodeClass> _testEntities;
private IEnumerable<IGrouping<string, EnvDTE.CodeClass>> _testGroupEntities;

/// <summary>
/// Bootstraps the standard test variables. Call once at the top of every test template.
/// Sets: _testAggName, _testEntities, _testGroupEntities
/// </summary>
private void InitTestVariables()
{
    _testEntities = GetEntities("Domain", withAttribute: "EndpointsT4");
    var proj = GetCurrentProject();
    var myName = proj.Name.Replace(GetDefaultNamespace() + ".", "").Split('.').First();
    _testAggName = myName + "Agg";
    _testGroupEntities = _testEntities.GroupBy(p => p.Namespace.FullName);
}
#>
