@using Lazy.Crud.<#= aggName #>.Application.DTO.Aggregates.<#= aggName #>Agg.Requests;

@inherits BaseListiningPage

@page "/<#= entity.Name #>"

<DefaultListining Page="this.Page"
                  Size="this.Size"
                  Title="<#=entity.Name#>"
                  T="<#= entity.Name #>ListiningDTO" 
                  AdditionalQueryString=<#= hasParameter ? $"@Query" :"\"\"" #>/>
<# if(hasParameter) { #>
@page "/<#= entity.Name #><#=hasParameter ? $@"/{'{'+parameterType.Key+'}'}" : ""#>"
@code {
    [Parameter] public string <#=parameterType.Key#> { get; set; }
    string Query => $"<#= hasParameter ? $"{parameterType.Key}Equal={'{'+parameterType.Key+'}'}" :"" #>";
}
<#}#>
<# SaveOutputToSubFolder($"{aggName}Agg/{entity.Name}", @$"Index.razor", true, ownership: Ownership.GeneratorOwned, templateId: "webapi.client-listining-pages.index"); #>
<# SaveOutputToSubFolder($"{aggName}Agg/{entity.Name}", @$"Index.razor.css", false, ownership: Ownership.GeneratedOnce, templateId: "webapi.client-listining-pages.index-css"); #>